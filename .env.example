# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Must match ORIGIN exactly, or auth silently 404s. See src/lib/server/auth.ts.
BETTER_AUTH_URL=""

# Feedback: optional in-app feedback button that files a GitHub issue.
# A fine-grained GitHub PAT for edrobertsrayne/planner (Issues: read & write).
# When set, the feedback button appears.
GITHUB_FEEDBACK_TOKEN=""
# OpenRouter key used to title the issue from the note. Optional: without it, the
# title falls back to the note's first line and the issue is still filed.
# The note is sent to OpenRouter for titling, so leave this unset if that is not wanted.
OPENROUTER_API_KEY=""
# Optional: overrides the code default (openai/gpt-6-luna) for feedback titles.
# OPENROUTER_MODEL="openai/gpt-6-luna"
